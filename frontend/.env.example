# Base URL of the Spring Boot backend's API.
# Copy this file to ".env" (or ".env.local") and adjust if your backend runs elsewhere.
# The backend in this project runs over HTTPS with a self-signed cert on port 8443 by default
# (see exportsystem/src/main/resources/application.properties), so the browser will need you
# to open https://localhost:8443 once and accept the certificate warning before login calls
# will succeed from the Vite dev server.
VITE_API_BASE_URL=https://localhost:8443/api
