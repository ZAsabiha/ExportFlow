spring.application.name=exportsystem


# PostgreSQL Connection
spring.datasource.url=jdbc:postgresql://localhost:5432/export_management
spring.datasource.username=postgres
spring.datasource.password=YOUR_DB_PASSWORD


# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Run schema-postgresql.sql (report view, trigram indexes) after Hibernate creates/updates
# the tables it reads from. Pinned to the postgresql platform so it's never picked up
# against the H2 database used by tests (its DDL - CREATE EXTENSION, GIN indexes - is
# Postgres-only and fails on H2).
spring.jpa.defer-datasource-initialization=true
spring.sql.init.mode=always
spring.sql.init.platform=postgresql
spring.sql.init.data-locations=optional:classpath:access-rules.sql
app.security.access-rules-refresh-ms=30000

# Spring Batch (bulk document import): we launch documentImportJob ourselves from
# BulkDocumentImportController, so don't auto-run any Job bean on startup. Postgres
# isn't an embedded DB, so Batch's own metadata tables need explicit init.
spring.batch.job.enabled=false
spring.batch.jdbc.initialize-schema=always


# SSL Configuration (HTTPS)
server.port=8443

server.ssl.enabled=true
server.ssl.key-store=classpath:application.p12
server.ssl.key-store-password=YOUR_KEYSTORE_PASSWORD
server.ssl.key-store-type=PKCS12
server.ssl.key-alias=application


spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@gmail.com
spring.mail.password=YOUR_GMAIL_APP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.mail.from=export_system <your-email@gmail.com>
# Inbox that receives submissions from the public Contact Us page.
app.mail.contact-to=your-email@gmail.com